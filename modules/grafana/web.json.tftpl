{
  "uid": "web-balanceador",
  "title": "Web y balanceador",
  "description": "Réplicas Flask y tráfico de Nginx en la red del entorno.",
  "schemaVersion": 41,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "contenedor",
        "label": "Contenedor",
        "type": "custom",
        "query": ${jsonencode(join(",", log_containers))},
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Réplicas Flask en ejecución",
      "description": "Cuenta por nombre los contenedores web que Docker marca como running. El objetivo viene del módulo web.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (container_name) (docker_container_status_pid{job=\"containers\",container_name=~\"${replicas}\",container_status=\"running\"})) or (0 * count(docker_container_status_pid{job=\"containers\"}))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: / ${total}",
          "min": 0,
          "noValue": "Sin datos",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": ${total}
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
%{ if enable_web_alert ~}
    {
      "id": 10,
      "type": "alertlist",
      "title": "Alerta de disponibilidad web",
      "description": "Grafana evalúa la regla cada 10 segundos. Si detecta cero réplicas, pasa a Pending. Si sigue en cero durante 30 segundos, pasa a Firing y se tramita el aviso por correo.",
      "gridPos": { "x": 5, "y": 0, "w": 7, "h": 6 },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "dashboardAlerts": true,
        "alertName": "Producción sin réplicas Flask en ejecución",
        "showInactiveAlerts": true,
        "stateFilter": {
          "normal": true,
          "pending": true,
          "firing": true,
          "recovering": true,
          "noData": true,
          "error": true
        }
      }
    },
%{ endif ~}
    {
      "id": 2,
      "type": "stat",
      "title": "Estado de Nginx",
      "description": "Indica si el exporter puede leer el estado de Nginx. Si Prometheus pierde contacto con el exporter se muestra «Sin datos».",
      "gridPos": { "x": ${enable_web_alert ? 12 : 5}, "y": 0, "w": 5, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_up{job=\"nginx\"} and on (job, instance) (up{job=\"nginx\"} == 1)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin respuesta",
                  "color": "red"
                },
                "1": {
                  "text": "Responde",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tráfico del balanceador",
      "description": "Peticiones HTTP por segundo, promediadas durante el último minuto. Incluye fotos, peticiones a Flask y consultas internas a stub_status.",
      "gridPos": { "x": ${enable_web_alert ? 17 : 10}, "y": 0, "w": ${enable_web_alert ? 7 : 14}, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total{job=\"nginx\"}[1m])",
          "instant": false,
          "range": true,
          "legendFormat": "Nginx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU de las réplicas",
      "description": "Cada línea corresponde a una réplica Flask. El 100 % equivale al uso de un núcleo.",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_name) (docker_container_cpu_usage_percent{job=\"containers\",container_name=~\"${replicas}\",cpu=\"cpu-total\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memoria de las réplicas",
      "description": "Memoria que Docker atribuye a cada contenedor Flask, convertida de bytes a MiB.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (container_name) (docker_container_mem_usage{job=\"containers\",container_name=~\"${replicas}\"}) / 1024 / 1024",
          "instant": false,
          "range": true,
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: MiB",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Historial de las réplicas Flask",
      "description": "Cada franja representa una réplica. Verde indica que Docker la observó en ejecución y rojo, parada, en pausa o reiniciándose. Un hueco indica ausencia de muestras. Telegraf puede tardar unos 20 s en retirar el estado anterior; durante esa transición tiene prioridad el estado de parada.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "0 * group by (container_name) (docker_container_status_pid{job=\"containers\",container_name=~\"${replicas}\",container_status!=\"running\"})\nor group by (container_name) (docker_container_status_pid{job=\"containers\",container_name=~\"${replicas}\",container_status=\"running\"})",
          "legendFormat": "{{container_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 85, "lineWidth": 0, "spanNulls": false },
          "mappings": [{
            "type": "value",
            "options": {
              "0": { "text": "Fuera de ejecución", "color": "red" },
              "1": { "text": "En ejecución", "color": "green" }
            }
          }]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "legend": { "showLegend": false },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Salud de los contenedores",
      "description": "Docker comprueba las réplicas Flask, PostgreSQL, MinIO, Nginx y Redis cuando el entorno tiene caché. Si todavía falta la primera medida, la tarjeta lo indica. Si hay dos estados durante la caducidad de las métricas, se priorizan parada, fallo e inicio, en ese orden.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "4 * group by (container_name) (docker_container_status_pid{job=\"containers\",container_name=~\"${health_services}\",container_status!=\"running\"})\nor 0 * group by (container_name) (docker_container_health_failing_streak{job=\"containers\",container_name=~\"${health_services}\",health_status=\"unhealthy\"})\nor group by (container_name) (docker_container_health_failing_streak{job=\"containers\",container_name=~\"${health_services}\",health_status=\"starting\"})\nor 2 * group by (container_name) (docker_container_health_failing_streak{job=\"containers\",container_name=~\"${health_services}\",health_status=\"healthy\"})\nor 3 * group by (container_name) (docker_container_status_pid{job=\"containers\",container_name=~\"${health_services}\"})",
          "legendFormat": "{{container_name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{
            "type": "value",
            "options": {
              "0": { "text": "Falla", "color": "red" },
              "1": { "text": "Iniciando", "color": "orange" },
              "2": { "text": "Sano", "color": "green" },
              "3": { "text": "Sin lectura", "color": "blue" },
              "4": { "text": "Fuera de ejecución", "color": "red" }
            }
          }]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": false,
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Estado de los contenedores",
      "description": "Último estado observado por Telegraf. Al cambiar de estado puede haber dos filas durante los 20 segundos que tarda en caducar la serie anterior.",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "group by (container_name, container_status) (docker_container_status_pid{job=\"containers\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Contenedor",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "container_name": 0,
              "container_status": 1
            },
            "renameByName": {
              "container_name": "Contenedor",
              "container_status": "Estado en Docker"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Registros de los contenedores ($contenedor)",
      "description": "Selecciona un contenedor del entorno para consultar su stdout y stderr en Loki. Si no hay líneas en el intervalo seleccionado, amplía el rango de tiempo.",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"$contenedor\"}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
