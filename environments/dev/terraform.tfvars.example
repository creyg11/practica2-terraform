# Copia este archivo a terraform.tfvars y elige una contraseña local.
# El navegador entra por Nginx y cada réplica recibe las peticiones por la red Docker.
nginx_bind_ip     = "127.0.0.1"
nginx_port        = 8081
web_replica_count = 2
web_internal_port = 5000

db_host           = "db"
db_port           = 5432
postgres_db       = "seleccion"
postgres_user     = "admin"
postgres_password = "CAMBIAR_POR_UNA_CONTRASENA_LOCAL"
