# Copia este archivo a terraform.tfvars y elige una contraseña local.
nginx_bind_ip     = "127.0.0.1"
nginx_port        = 8080
# El enunciado exige al menos tres instancias web en producción.
web_replica_count = 3
web_internal_port = 5000

db_host           = "db"
db_port           = 5432
postgres_db       = "seleccion"
postgres_user     = "admin"
postgres_password = "CAMBIAR_POR_UNA_CONTRASENA_LOCAL"

redis_host = "redis"
redis_port = 6379

minio_host          = "minio"
minio_root_user     = "minioadmin"
minio_root_password = "CAMBIAR_POR_UNA_CONTRASENA_LOCAL"
# minio_api_port    = 9000  # valor por defecto
# minio_console_port = 9001 # valor por defecto

# Grupo que permite a Telegraf consultar Docker. En cada host: stat -c %g /var/run/docker.sock
docker_socket_gid = 984
